<div id="paginationControls" class="pagination-controls">
  <button id="prevPageBtn" aria-label="Página anterior" disabled>&#171;</button>
  <input
    id="pageInput"
    type="number"
    min="1"
    value="1"
    aria-label="Número de página"
  />
  <span id="pageInfo">Página 1</span>
  <button id="nextPageBtn" aria-label="Página siguiente" disabled>&#187;</button>
</div>
